{
  "name": "remix-3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "upgrade": "npx npm-check-updates -u",
    "upgrade-check": "npx npm-check-updates",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc -b",
    "routes": "remix routes --table",
    "doctor": "remix doctor",
    "format": "oxfmt --check \"./{app,test}/**/*.{ts,tsx}\" \"./*.ts\"",
    "format-fix": "oxfmt --write \"./{app,test}/**/*.{ts,tsx}\" \"./*.ts\"",
    "lint": "oxlint . --max-warnings=0",
    "lint-fix": "oxlint --fix .",
    "stylelint": "stylelint \"./public/**/*.css\"",
    "stylelint-fix": "stylelint --fix \"./public/**/*.css\"",
    "pre-commit": "npm run typecheck && npm run format-fix && npm run lint-fix && npm run stylelint-fix"
  },
  "dependencies": {
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "volta": {
    "node": "26.13.0"
  }
}
